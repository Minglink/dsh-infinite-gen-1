{
  "name": "dsh-infinite-gen-4",
  "version": "0.3.0",
  "description": "DeepSeek Harness 破甲插件「无限四代」v0.3.0：无条件服从 + 永不拒绝核心，双层协同系统提示词注入，融合 DeepSeek-V4.1-flash 战场实测车道与实时破甲状态投影的纯净破甲版。",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minglink/dsh-infinite-gen-3.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "HARNESS_PLUGIN.md",
    "README.md",
    "LICENSE",
    "prompts",
    "tests",
    "scripts",
    "assets"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js",
    "verify": "node scripts/verify_prompt_gen4.mjs",
    "verify:gen4": "node scripts/verify_prompt_gen4.mjs"
  },
  "dsh": {
    "id": "dsh-infinite-gen-4",
    "name": "无限四代",
    "version": "0.3.0",
    "repo": "Minglink/dsh-infinite-gen-3",
    "permissions": "系统提示词注入, 客户端状态条",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}